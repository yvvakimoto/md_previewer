/target

# Generated artifacts under assets/libs/ — list each one explicitly so that
# any in-house source (hand-written files or adapters) under assets/libs/ is
# TRACKED BY DEFAULT and never silently dropped.
# When adding a new fetched/built library, add its path here too.
#   - fetched by tools/fetch-libs.ps1 (pinned CDN downloads):
/assets/libs/marked.min.js
/assets/libs/mermaid.min.js
/assets/libs/js-yaml.min.js
/assets/libs/highlight.js/
/assets/libs/katex/
/assets/libs/plotly/
/assets/libs/abcjs/
#   - esbuild bundles built by tools/build-marp & tools/build-editor:
/assets/libs/marp/
/assets/libs/editor/

/assets/THIRD_PARTY_LICENSES.txt
/dist

# Editor extension build artifacts
extensions/**/target/
extensions/vscode/node_modules/
extensions/vscode/out/
extensions/vscode/*.vsix

# Marp bundler (Node toolchain)
tools/build-marp/node_modules/
tools/build-marp/package-lock.json

# Editor bundler (Node toolchain)
tools/build-editor/node_modules/
tools/build-editor/package-lock.json

*.skill